{
 "sobre": "Modelos de leitura por documento (MODELOS.md): só regras, nada de dado pessoal. Cada modelo diz os sinais que reconhecem o documento, a impressão do layout (rótulos fixos), os campos por âncora, a tabela de itens e as conferências. Amostras em dados/amostras/ como esqueleto (dígitos → 0, nomes → X), no texto que o próprio motor tira do PDF (pdf.js).",
 "versao": 1,
 "modelos": [
  {
   "id": "escola-boleto-matricula",
   "versao": 1,
   "tipo": "boleto",
   "apps": [
    "moneytrio"
   ],
   "nome": {
    "pt": "Boleto da matrícula (escola)",
    "en": "School enrollment bank slip"
   },
   "sinais": [
    "PARCELA DA ANUIDADE",
    "VALOR A PAGAR",
    "VENCIMENTO"
   ],
   "impressao": [
    "\\bALUNO\\b",
    "MATR[IÍ]CULA",
    "VALOR BRUTO",
    "DESCONTOS",
    "BENEFICI[AÁ]RIO",
    "VENCIMENTO",
    "VALOR DO DOCUMENTO",
    "AG[EÊ]NCIA"
   ],
   "campos": {
    "Valor bruto": {
     "ancora": "PARCELA DA ANUIDADE|VALOR BRUTO DESCONTOS VALOR A PAGAR",
     "n": -1,
     "onde": "linha-abaixo",
     "pega": "dinheiro",
     "indice": 0
    },
    "Desconto": {
     "ancora": "PARCELA DA ANUIDADE|VALOR BRUTO DESCONTOS VALOR A PAGAR",
     "n": -1,
     "onde": "linha-abaixo",
     "pega": "dinheiro",
     "indice": 1
    },
    "Valor": {
     "ancora": "PARCELA DA ANUIDADE|VALOR BRUTO DESCONTOS VALOR A PAGAR",
     "n": -1,
     "onde": "linha-abaixo",
     "pega": "dinheiro",
     "indice": 2
    },
    "Vencimento": {
     "ancora": "^VENCIMENTO",
     "onde": "coluna",
     "pega": "data"
    },
    "Beneficiário": {
     "ancora": "BENEFICI[AÁ]RIO CNPJ",
     "onde": "linha-abaixo",
     "pega": "regex:^(.*?)\\s*\\d{2}\\.?\\d{3}\\.?\\d{3}\\/?\\d{4}"
    },
    "CNPJ": {
     "ancora": "BENEFICI[AÁ]RIO CNPJ",
     "onde": "linha-abaixo",
     "pega": "cnpj"
    },
    "Aluno": {
     "ancora": "^ALUNO\\b",
     "onde": "mesma-linha",
     "pega": "regex:^\\s*(.*?)\\s+MATR[IÍ]CULA"
    },
    "Matrícula": {
     "ancora": "MATR[IÍ]CULA",
     "onde": "mesma-linha",
     "pega": "numero"
    }
   },
   "vitais": [
    "Valor",
    "Vencimento"
   ],
   "conferencias": [
    {
     "tipo": "soma",
     "de": [
      "Valor bruto",
      "-Desconto"
     ],
     "igual": "Valor",
     "nome": "bruto menos desconto não dá o valor a pagar"
    }
   ],
   "amostra": "dados/amostras/escola-boleto-matricula.txt"
  },
  {
