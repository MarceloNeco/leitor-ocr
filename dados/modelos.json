  {
   "id": "escola-contrato",
   "versao": 1,
   "tipo": "contrato",
   "apps": [
    "moneytrio"
   ],
   "nome": {
    "pt": "Contrato de serviços de educação escolar",
    "en": "School services contract"
   },
   "sinais": [
    "CONTRATO DE SERVI[CÇ]OS DE EDUCA",
    "ANUIDADE",
    "PARCELA"
   ],
   "impressao": [
    "EDUCANDO",
    "NOME COMPLETO",
    "ANO LETIVO",
    "VALOR DA ANUIDADE",
    "N[UÚ]MERO DE PARCELA",
    "VALOR DE CADA PARCELA"
   ],
   "campos": {
    "Escola": {
     "ancora": "^(ASSOCIA|COL[EÉ]GIO|ESCOLA|INSTITUTO|CENTRO EDUCACIONAL)",
     "onde": "mesma-linha",
     "pega": "regex:^(.+)$",
     "inteira": true
    },
    "Ano letivo": {
     "ancora": "CONTRATO DE SERVI|ANO LETIVO",
     "onde": "mesma-linha",
     "pega": "regex:(20\\d\\d)"
    },
    "Aluno": {
     "ancora": "NOME COMPLETO",
     "n": 1,
     "onde": "mesma-linha",
     "pega": "texto"
    },
    "Dia do vencimento": {
     "ancora": "VENC[IÍ]VEIS NO DIA",
     "onde": "mesma-linha",
     "inteira": true,
     "pega": "regex:VENC[IÍ]VEIS NO DIA\\s*(\\d{1,2})"
    },
    "Parcelas": {
     "ancora": "MENSAIS IGUAIS",
     "onde": "mesma-linha",
     "inteira": true,
     "pega": "regex:(\\d{1,2})\\s+MENSAIS"
    }
   },
   "tabela": {
    "inicio": "CURSO\\s*/\\s*ETAPA",
    "fim": "CL[AÁ]USULA\\s+8|^\\s*$",
    "colunas": [
     "texto",
     "dinheiro",
     "dinheiro",
     "dinheiro",
     "numero",
     "dinheiro"
    ],
    "nomes": [
     "etapa",
     "anuidade",
     "primeira",
     "restante",
     "parcelas",
     "parcela"
    ],
    "minimo": 1
   },
   "vitais": [
    "Escola",
    "Ano letivo"
   ],
   "conferencias": [],
   "amostra": "dados/amostras/escola-contrato.txt"
  },
